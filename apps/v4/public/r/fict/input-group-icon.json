      "content": "import { InputGroup, InputGroupAddon, InputGroupInput } from '@/components/ui/input-group'\n\nexport default function InputGroupIconExample() {\n  return (\n    <div class=\"grid w-full max-w-sm gap-6\">\n      <InputGroup>\n        <InputGroupInput placeholder=\"Search...\" />\n        <InputGroupAddon>\n          <span aria-hidden=\"true\">•</span>\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput type=\"email\" placeholder=\"Enter your email\" />\n        <InputGroupAddon>\n          <span aria-hidden=\"true\">•</span>\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Card number\" />\n        <InputGroupAddon>\n          <span aria-hidden=\"true\">•</span>\n        </InputGroupAddon>\n        <InputGroupAddon align=\"inline-end\">\n          <span aria-hidden=\"true\">•</span>\n        </InputGroupAddon>\n      </InputGroup>\n      <InputGroup>\n        <InputGroupInput placeholder=\"Card number\" />\n        <InputGroupAddon align=\"inline-end\">\n          <span aria-hidden=\"true\">•</span>\n          <span aria-hidden=\"true\">•</span>\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  )\n}\n",
