{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sheet-demo",
  "type": "registry:example",
  "description": "Drawer-style sheet based on dialog primitives example for Fict",
  "dependencies": [],
  "registryDependencies": [
    "button",
    "input",
    "label",
    "sheet"
  ],
  "files": [
    {
      "path": "src/examples/sheet-demo.tsx",
      "content": "import { Button } from '@/components/ui/button'\nimport { Input } from '@/components/ui/input'\nimport { Label } from '@/components/ui/label'\nimport {\n  Sheet,\n  SheetClose,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from '@/components/ui/sheet'\n\nexport default function SheetDemoExample() {\n  return (\n    <Sheet>\n      <SheetTrigger asChild>\n        <Button variant=\"outline\">Open</Button>\n      </SheetTrigger>\n      <SheetContent>\n        <SheetClose class=\"absolute right-4 top-4\" aria-label=\"Close\">×</SheetClose>\n        <SheetHeader>\n          <SheetTitle>Edit profile</SheetTitle>\n          <SheetDescription>Make changes to your profile here. Click save when you're done.</SheetDescription>\n        </SheetHeader>\n        <div class=\"grid flex-1 gap-4 py-4\">\n          <div class=\"grid gap-2\">\n            <Label for=\"sheet-demo-name\">Name</Label>\n            <Input id=\"sheet-demo-name\" value=\"Pedro Duarte\" />\n          </div>\n          <div class=\"grid gap-2\">\n            <Label for=\"sheet-demo-username\">Username</Label>\n            <Input id=\"sheet-demo-username\" value=\"@peduarte\" />\n          </div>\n        </div>\n        <SheetFooter>\n          <Button type=\"submit\">Save changes</Button>\n          <SheetClose asChild><Button variant=\"outline\">Close</Button></SheetClose>\n        </SheetFooter>\n      </SheetContent>\n    </Sheet>\n  )\n}\n",
      "type": "registry:page"
    }
  ]
}
