{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "select-invalid",
  "type": "registry:example",
  "description": "Select primitive wrappers example for Fict",
  "dependencies": [],
  "registryDependencies": [
    "select"
  ],
  "files": [
    {
      "path": "src/examples/select-invalid.tsx",
      "content": "import {\n  Select,\n  SelectContent,\n  SelectGroup,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from '@/components/ui/select'\n\nexport default function SelectInvalidExample() {\n  return (\n    <div class=\"grid w-full max-w-48 gap-2\">\n      <label>Fruit</label>\n      <Select>\n        <SelectTrigger aria-invalid=\"true\">\n          <SelectValue placeholder=\"Select a fruit\" />\n        </SelectTrigger>\n        <SelectContent>\n          <SelectGroup>\n            {['Apple', 'Banana', 'Blueberry', 'Grapes', 'Pineapple'].map(fruit => (\n              <SelectItem value={fruit.toLowerCase()}>{fruit}</SelectItem>\n            ))}\n          </SelectGroup>\n        </SelectContent>\n      </Select>\n      <p class=\"text-sm text-destructive\">Please select a fruit.</p>\n    </div>\n  )\n}\n",
      "type": "registry:page"
    }
  ]
}
