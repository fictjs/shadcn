{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "avatar-demo",
  "type": "registry:example",
  "description": "Avatar primitives with badges, sizes, and groups example for Fict",
  "dependencies": [],
  "registryDependencies": [
    "avatar"
  ],
  "files": [
    {
      "path": "src/examples/avatar-demo.tsx",
      "content": "import { Avatar, AvatarBadge, AvatarFallback, AvatarGroup, AvatarGroupCount, AvatarImage } from '@/components/ui/avatar'\n\nexport default function AvatarDemoExample() {\n  return (\n    <div class=\"flex flex-wrap items-center gap-6 md:gap-12\">\n      <Avatar><AvatarImage class=\"grayscale\" src=\"https://github.com/shadcn.png\" alt=\"@shadcn\" /><AvatarFallback>CN</AvatarFallback></Avatar>\n      <Avatar><AvatarImage src=\"https://github.com/evilrabbit.png\" alt=\"@evilrabbit\" /><AvatarFallback>ER</AvatarFallback><AvatarBadge class=\"bg-green-600 dark:bg-green-800\" /></Avatar>\n      <AvatarGroup class=\"grayscale\">\n        <Avatar><AvatarImage src=\"https://github.com/shadcn.png\" alt=\"@shadcn\" /><AvatarFallback>CN</AvatarFallback></Avatar>\n        <Avatar><AvatarImage src=\"https://github.com/maxleiter.png\" alt=\"@maxleiter\" /><AvatarFallback>LR</AvatarFallback></Avatar>\n        <Avatar><AvatarImage src=\"https://github.com/evilrabbit.png\" alt=\"@evilrabbit\" /><AvatarFallback>ER</AvatarFallback></Avatar>\n        <AvatarGroupCount>+3</AvatarGroupCount>\n      </AvatarGroup>\n    </div>\n  )\n}\n",
      "type": "registry:page"
    }
  ]
}
