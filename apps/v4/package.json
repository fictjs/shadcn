{
  "name": "@fictjs/shadcn-v4-site",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "build": "pnpm build:client && pnpm build:server && pnpm verify:build",
    "build:pages": "SITE_BASE_PATH=/shadcn/ pnpm build && node scripts/export-static.mjs",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server.tsx",
    "start": "NODE_ENV=production node server.js",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:compiler": "node scripts/verify-compiler.mjs",
    "verify:published": "node scripts/verify-published-packages.mjs",
    "test:e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@fictjs/runtime": "0.33.0",
    "@fictjs/ssr": "0.33.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0",
    "express": "^5.1.0",
    "fict": "0.33.0",
    "shiki": "3.19.0"
  },
  "devDependencies": {
    "@fictjs/compiler": "0.33.0",
    "@fictjs/hooks": "0.30.0",
    "@fictjs/vite-plugin": "0.33.0",
    "@playwright/test": "1.58.2",
    "@types/express": "^5.0.5",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "pnpm": {
    "patchedDependencies": {
      "@fictjs/runtime@0.33.0": "patches/@fictjs__runtime@0.33.0.patch"
    }
  }
}
